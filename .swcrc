{
  "$schema": "https://json.schemastore.org/swcrc",
  "module": {
    "type": "es6"
  },
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": true,
      "dynamicImport": true
    },
    "target": "es2022",
    "baseUrl": ".",
    "experimental": {
      "plugins": [["@lingui/swc-plugin", {}]]
    }
  },
  "exclude": ["node_modules/**/**"]
}
