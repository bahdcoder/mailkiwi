{
  "name": "@kibamail/app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm mysql:migrate:dev && pnpm quick:dev",
    "quick:dev": "env-cmd tsx watch --clear-screen=false --ignore views/app --ignore build/ --ignore ./vite.config.ts*.*.mjs --ignore ./**/+config.ts.build-*.mjs app/start/dev.ts",
    "test:server": "env-cmd -f .env.test pnpm test:watch --run",
    "test": "pnpm test:server && pnpm test:client",
    "build:clean": "del-cli build",
    "test:watch": "pnpm mysql:migrate:test && env-cmd -f .env.test vitest",
    "test:client:watch": "vitest --config vitest.client.config.ts",
    "test:client": "pnpm test:client:watch --run",
    "types:check": "tsc --noEmit",
    "build:client": "vite build",
    "test:coverage": "pnpm mysql:migrate:test && env-cmd -f .env.test vitest --run --coverage",
    "build": "pnpm test && pnpm types:check && pnpm build:quick",
    "format": "pnpm prettier . --write",
    "start": "env-cmd node build/core/app/start/prod.js",
    "build:app": "tsc",
    "build:quick": "pnpm build:clean && pnpm build:app && pnpm build:client && pnpm cli fix_typescript_imports",
    "mysql:seed:dev": "pnpm mysql:migrate:dev && env-cmd tsx bin/seed.ts",
    "mysql:migrate:dev": "env-cmd pnpm mysql:migrate",
    "mysql:migrate:test": "env-cmd -f .env.test pnpm mysql:migrate",
    "mysql:migrate": "pnpm drizzle-kit migrate",
    "mysql:migrate:make": "env-cmd pnpm drizzle-kit generate",
    "mysql:studio": "pnpm drizzle-kit studio",
    "cli": "env-cmd tsx cli/cli_root.ts",
    "docker:dev": "pnpm docker:mysql:migrate:dev && pnpm docker:quick:dev",
    "docker:mysql:migrate:dev": "env-cmd-docker pnpm mysql:migrate",
    "docker:quick:dev": "env-cmd-docker tsx watch --clear-screen=false --ignore views/app --ignore build/ --ignore ./vite.config.ts*.*.mjs --ignore ./**/+config.ts.build-*.mjs app/start/dev.ts"
  },
  "keywords": [
    "open source",
    "email marketing",
    "transactional email",
    "email marketing platform"
  ],
  "author": "Frantz Kati <hey@katifrantz.com>",
  "license": "ISC",
  "description": "Kiba: The developer friendly email platform for modern businesses.",
  "devDependencies": {
    "@drizzle-team/brocli": "^0.9.2",
    "@faker-js/faker": "^8.4.1",
    "@fastify/vite": "^6.0.6",
