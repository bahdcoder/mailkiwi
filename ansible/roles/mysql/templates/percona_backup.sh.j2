#!/bin/bash

# percona_backup.sh - automated mysql backup script using percona xtrabackup
# this script performs a full backup once a week (sunday) and incremental backups on other days

# set -e to exit on error
set -e

# variables
BACKUP_DIR="{{ mysql_backup_dir }}"
FULL_BACKUP_DIR="$BACKUP_DIR/full"
INCREMENTAL_BACKUP_DIR="$BACKUP_DIR/incremental"
MYSQL_USER="root"
MYSQL_PASSWORD="{{ mysql_root_password }}"
DATE=$(date +%Y-%m-%d-%H-%M-%S)
DOW=$(date +%u)  # day of week (1-7), 7 is sunday
THREADS={{ mysql_percona_backup_threads }}
MEMORY="{{ mysql_percona_use_memory }}"

# ensure backup directories exist
mkdir -p $FULL_BACKUP_DIR
mkdir -p $INCREMENTAL_BACKUP_DIR

# determine backup type (full on sunday, incremental on other days)
if [ "$DOW" -eq 7 ]; then
  # sunday - full backup
  echo "starting full mysql backup using percona xtrabackup at $(date)"

  # create backup directory for this full backup
  BACKUP_PATH="$FULL_BACKUP_DIR/full-$DATE"
  mkdir -p $BACKUP_PATH

  # perform full backup with binary log info
  xtrabackup --backup \
    --user=$MYSQL_USER \
    --password=$MYSQL_PASSWORD \
    --target-dir=$BACKUP_PATH \
    --parallel=$THREADS \
    --use-memory=$MEMORY \
    --binlog-info=ON \
    {% if mysql_percona_compress %}--compress --compress-threads=$THREADS --compress-level={{ mysql_percona_compress_level }}{% endif %}

  # create a symlink to the latest full backup
  ln -sf $BACKUP_PATH $FULL_BACKUP_DIR/latest

  echo "full mysql backup completed at $(date)"
  echo "backup saved to $BACKUP_PATH"
  echo "backup size: $(du -sh $BACKUP_PATH | cut -f1)"
else
  # weekday - incremental backup
  echo "starting incremental mysql backup using percona xtrabackup at $(date)"

  # check if we have a full backup to base the incremental on
  if [ ! -d "$FULL_BACKUP_DIR/latest" ]; then
    echo "no full backup found, performing full backup instead"

    # create backup directory for this full backup
    BACKUP_PATH="$FULL_BACKUP_DIR/full-$DATE"
    mkdir -p $BACKUP_PATH

    # perform full backup with binary log info
    xtrabackup --backup \
      --user=$MYSQL_USER \
      --password=$MYSQL_PASSWORD \
      --target-dir=$BACKUP_PATH \
      --parallel=$THREADS \
      --use-memory=$MEMORY \
      --binlog-info=ON \
      {% if mysql_percona_compress %}--compress --compress-threads=$THREADS --compress-level={{ mysql_percona_compress_level }}{% endif %}

    # create a symlink to the latest full backup
    ln -sf $BACKUP_PATH $FULL_BACKUP_DIR/latest

    echo "full mysql backup completed at $(date)"
    echo "backup saved to $BACKUP_PATH"
    echo "backup size: $(du -sh $BACKUP_PATH | cut -f1)"
  else
    # create backup directory for this incremental backup
    BACKUP_PATH="$INCREMENTAL_BACKUP_DIR/inc-$DATE"
    mkdir -p $BACKUP_PATH

    # perform incremental backup with binary log info
    xtrabackup --backup \
      --user=$MYSQL_USER \
      --password=$MYSQL_PASSWORD \
      --target-dir=$BACKUP_PATH \
      --incremental-basedir=$FULL_BACKUP_DIR/latest \
      --parallel=$THREADS \
      --use-memory=$MEMORY \
      --binlog-info=ON \
      {% if mysql_percona_compress %}--compress --compress-threads=$THREADS --compress-level={{ mysql_percona_compress_level }}{% endif %}

    echo "incremental mysql backup completed at $(date)"
    echo "backup saved to $BACKUP_PATH"
    echo "backup size: $(du -sh $BACKUP_PATH | cut -f1)"
  fi
fi

# set permissions
find $BACKUP_DIR -type d -exec chmod 750 {} \;
find $BACKUP_DIR -type f -exec chmod 640 {} \;

echo "backup process completed successfully at $(date)"
exit 0
