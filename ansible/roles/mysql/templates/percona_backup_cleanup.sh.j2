#!/bin/bash

# percona_backup_cleanup.sh - removes old mysql backups
# this script keeps full backups for the retention period and removes associated incremental backups

# set -e to exit on error
set -e

# variables
BACKUP_DIR="{{ mysql_backup_dir }}"
FULL_BACKUP_DIR="$BACKUP_DIR/full"
INCREMENTAL_BACKUP_DIR="$BACKUP_DIR/incremental"
RETENTION_DAYS={{ mysql_backup_retention_days }}
DATE=$(date +%Y-%m-%d)

echo "cleaning up mysql backups older than $RETENTION_DAYS days"

# find and delete full backups older than retention period
echo "finding full backups older than $RETENTION_DAYS days..."
for backup in $(find $FULL_BACKUP_DIR -maxdepth 1 -name "full-*" -type d -mtime +$RETENTION_DAYS | sort); do
  echo "removing old full backup: $backup"
  rm -rf $backup
done

# find and delete incremental backups older than retention period
echo "finding incremental backups older than $RETENTION_DAYS days..."
for backup in $(find $INCREMENTAL_BACKUP_DIR -maxdepth 1 -name "inc-*" -type d -mtime +$RETENTION_DAYS | sort); do
  echo "removing old incremental backup: $backup"
  rm -rf $backup
done

# clean up log files older than retention period
echo "cleaning up old log files..."
find $BACKUP_DIR/logs -name "*.log" -type f -mtime +$RETENTION_DAYS -delete

echo "mysql backup cleanup completed at $(date)"
echo "remaining backups:"
echo "full backups:"
ls -lh $FULL_BACKUP_DIR | grep -v "latest" | grep "full-"
echo "incremental backups:"
ls -lh $INCREMENTAL_BACKUP_DIR | grep "inc-"

exit 0
